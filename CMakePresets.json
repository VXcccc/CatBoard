{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
			"toolchainFile" : "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "mingw-debug",
      "displayName": "MinGW Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
      }
    },
    {
      "name": "mingw-release",
      "displayName": "MinGW Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "CMAKE_EXE_LINKER_FLAGS": "-static"
      }
    },
    {
      "name": "mingw-release-portable",
      "displayName": "MinGW Release",
      "inherits": "mingw-release",
      "cacheVariables": {
        "CATBOARD_PORTABLE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "mingw-debug", "configurePreset": "mingw-debug" },
    { "name": "mingw-release", "configurePreset": "mingw-release" },
		{ "name": "mingw-release-portable", "configurePreset": "mingw-release-portable" }
  ], 
"packagePresets": [
  { "name": "portable-zip", "configurePreset": "mingw-release-portable", "generators": ["ZIP"] },
  { "name": "installer",    "configurePreset": "mingw-release", "generators": ["NSIS"] }
]
}
